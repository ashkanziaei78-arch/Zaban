<?xml version="1.0" encoding="UTF-8"?>
<!--
  نشانی‌های وبلاگ روی IIS.

  هاست تاکورا ویندوز است (Microsoft-IIS/10.0, PleskWin). IIS فایل
  .htaccess را اصلاً نمی‌خواند — پس همان قواعدی که در .htaccess کنار
  این فایل نوشته شده، اینجا هم باید تکرار شود. هر دو را نگه می‌داریم
  تا اگر روزی روی آپاچی رفت، از کار نیفتد.

  چرا نشانی زیبا مهم است: /blog/راهنمای-آزمون-آیلتس کلیدواژه را در
  خودِ نشانی دارد. گوگل ?slug= را هم می‌خواند، ولی آنچه در نتیجه نشان
  می‌دهد و آدم رویش کلیک می‌کند، اولی است.

  اگر ماژول URL Rewrite روی سرور نصب نباشد، IIS به این فایل خطای
  500.19 می‌دهد. در آن صورت این فایل را بردارید و به‌جایش در
  api/config.php بنویسید:  'blog_pretty_urls' => false
  آن‌وقت خود PHP نشانی‌ها را به شکل ?slug= می‌سازد و همه‌چیز بی هیچ
  بازنویسی‌ای کار می‌کند.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- فایل و پوشهٔ واقعی دست‌نخورده می‌مانند (تصویرها، CSS) -->
        <rule name="blog-real-files" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAny">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="None" />
        </rule>

        <rule name="blog-feed" stopProcessing="true">
          <match url="^feed\.xml$" />
          <action type="Rewrite" url="feed.php" />
        </rule>

        <rule name="blog-sitemap" stopProcessing="true">
          <match url="^sitemap\.xml$" />
          <action type="Rewrite" url="sitemap.php" />
        </rule>

        <!-- /blog/c/<دسته> -->
        <rule name="blog-category" stopProcessing="true">
          <match url="^c/([^/]+)/?$" />
          <action type="Rewrite" url="index.php?c={R:1}" appendQueryString="true" />
        </rule>

        <!-- /blog/<نشانی-نوشته> -->
        <rule name="blog-post" stopProcessing="true">
          <match url="^([^/]+)/?$" />
          <action type="Rewrite" url="post.php?slug={R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <!--
      فایل‌های درونی وبلاگ از بیرون خوانده نمی‌شوند. _blog.php فقط
      include می‌شود و هیچ‌وقت مستقیم صدا زده نمی‌شود.
    -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="uploads-tmp" />
        </hiddenSegments>
        <denyUrlSequences>
          <add sequence="_blog.php" />
        </denyUrlSequences>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
