# فقط نقاط پایانی باید از بیرون قابل فراخوانی باشند
<FilesMatch "^(_bootstrap|_sms|_ctx|_settings|_creds|_schema|config|config\.sample)\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(sql|md|log|bak|sample)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header set Cache-Control "no-store"
  Header set X-Content-Type-Options "nosniff"
</IfModule>

Options -Indexes
